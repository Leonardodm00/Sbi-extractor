__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# export artifacts -- NEVER versioned (they are data, often GB-scale)
export/
out/
outputs/
*.parquet
*.pt
*.pth
*.npz
*.npy

# PBS job streams
*.o[0-9]*
*.e[0-9]*

# repo-local, machine-specific artifacts (checkpoint copy, real-cohort
# specs, sbi_hpc pointer) -- see artifacts/README.md. Everything here is
# ignored except that README, which documents provenance and how to
# repopulate on a fresh clone.
/artifacts/*
!/artifacts/README.md

# extractor/ (migration step 3): the per-machine job list holds absolute
# cluster paths and is regenerated by list_extraction_jobs.py; the flags file
# beside it IS tracked (it is the cohort's numbers).
extractor/extraction_manifest.tsv

# sim_reextract (Stage C, C8): per-run state, never versioned
sim_reextract/plan.json
sim_reextract/tasks.tsv
sim_reextract/tasks_test.tsv
# ... and the same for every tagged cohort (COHORT_TAG=<tag>: sim_reextract/<tag>/;
# giulia, linddup, ...): every subfolder but the tracked profiles/ (2026-10-29)
sim_reextract/*/
!sim_reextract/profiles/
# export_windows (B5): each data set's per-run plan folder export_windows/<tag>/,
# never versioned (D-079): every subfolder but the tracked profiles/ (2026-10-29)
export_windows/*/
!export_windows/profiles/
